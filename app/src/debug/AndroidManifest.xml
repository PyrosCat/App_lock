<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      M7 WP2 (change E) Gate-2 test support, DEBUG builds only. SentinelActivity is a full-screen touch
      recorder used to prove, with a real underlying touch (not an inference from window focus), that an
      interactive overlay BLOCKS touches to the app beneath and a dismissed (pass-through) overlay lets them
      through. It is declared in the TARGET (com.applock) debug manifest, not the androidTest APK, because
      ActivityScenario.launch(Class) resolves the intent against the target-app context. It ships only in
      debuggable builds and is exported=false.
    -->
    <application>
        <activity
            android:name="com.applock.e2e.SentinelActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!--
          M7 WP2 (change F3) device-test support, DEBUG builds only. FakeHomeActivity is a second home launcher
          for HomeResolverDeviceTest. It is disabled, so it adds no HOME candidate (and no launcher chooser). The
          test enables it only while it runs and resets it to this default afterwards.
        -->
        <activity
            android:name="com.applock.e2e.FakeHomeActivity"
            android:enabled="false"
            android:exported="true"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
